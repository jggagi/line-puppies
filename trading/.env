# QQQ Attribution & Master Critique System Settings

# Google Gemini API Key (Required for default LLM client)
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: OpenAI API Key (if you want to use OpenAI models)
OPENAI_API_KEY=

# Optional: Default LLM provider ("gemini" or "openai")
DEFAULT_LLM_PROVIDER=gemini
